{
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "src/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "handle": "filesystem" },

    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },

    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}